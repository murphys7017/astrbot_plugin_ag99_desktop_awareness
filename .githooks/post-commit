#!/bin/sh

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  echo "Desktop awareness post-commit deploy skipped: failed to resolve repo root." >&2
  exit 0
fi

DEPLOY_SCRIPT="$REPO_ROOT/deploy_desktop_awareness.ps1"
if [ ! -f "$DEPLOY_SCRIPT" ]; then
  echo "Desktop awareness post-commit deploy skipped: deploy script not found." >&2
  exit 0
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$DEPLOY_SCRIPT"
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "Desktop awareness post-commit deploy failed with status $STATUS." >&2
  exit "$STATUS"
fi
exit 0
